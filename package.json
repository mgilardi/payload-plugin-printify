{
  "name": "payload-plugin-printify",
  "version": "0.1.0",
  "description": "Printify print-on-demand for Payload's ecommerce plugin: product sync, order fulfillment and tracking, optional price write-back.",
  "keywords": ["payload", "payload-plugin", "payloadcms", "printify", "ecommerce", "print-on-demand"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/mgilardi/payload-plugin-printify.git" },
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20.9" },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target node20",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "payload": "^3.60.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "payload": "3.92.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
